{
  "name": "benchmarking-visual",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "sitio": "node generador/construir.mjs",
    "ver": "node generador/servidor.mjs",
    "browsers": "playwright install chromium",
    "capture": "node pipeline/capture.mjs",
    "sites": "node pipeline/build-sites.mjs",
    "validate": "node pipeline/validate.mjs",
    "demo:data": "node pipeline/demo/generate-demo.mjs",
    "test": "vitest run",
    "check": "npm run validate && npm test && npm run sitio",
    "imagenes": "node pipeline/optimizar-imagenes.mjs",
    "capturar-desde-mi-compu": "node pipeline/capture.mjs --pendientes --navegador --continuar",
    "exportar": "node pipeline/exportar.mjs",
    "importar": "node pipeline/importar.mjs"
  },
  "devDependencies": {
    "vitest": "2.1.4",
    "sharp": "0.33.5",
    "adm-zip": "0.5.16"
  },
  "optionalDependencies": {
    "playwright": "1.48.2"
  }
}